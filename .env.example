# Переменные окружения bjj59.ru. Скопируй в .env.local для разработки,
# на проде задаются в Vercel → Settings → Environment Variables.

# --- Заявки: единственный рабочий канал. Без них заявки только в логах.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Запасной канал заявок (письмо). Уходит всегда; при падении Telegram —
# с пометкой «⚠️ Telegram недоступен». Аккаунт: resend.com, домен bjj59.ru.
RESEND_API_KEY=
NOTIFY_EMAIL=

# --- Админка /admin
ADMIN_PASSWORD=
# Любая длинная случайная строка. Смена = все сессии админки разлогинены.
SESSION_SECRET=

# --- Сохранение из админки: коммит в репозиторий, Vercel пересобирает сайт.
# Fine-grained token: github.com → Settings → Developer settings → Tokens →
# Generate new token → Repository access: только bjj59-site →
# Permissions → Contents: Read and write. Без токена (локально) пишем в файл.
GITHUB_TOKEN=
GITHUB_REPO=german9827387/bjj59-site
GITHUB_BRANCH=main

# --- Новости из ВКонтакте (блок «Новости» на главной)
VK_TOKEN=
VK_GROUP_ID=

NEXT_PUBLIC_BASE_URL=https://www.bjj59.ru
